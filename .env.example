DATABASE_PATH=./data/wedplan.db
UPLOAD_DIR=./data/uploads
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32

# Dipakai sekali saat `pnpm db:seed`
SEED_PRIA_EMAIL=pria@contoh.id
SEED_PRIA_PASSWORD=ubah-password-ini
SEED_WANITA_EMAIL=wanita@contoh.id
SEED_WANITA_PASSWORD=ubah-password-ini

# Reminder WhatsApp lewat WAHA.
# WAHA_BASE_URL kosong = reminder dimatikan sepenuhnya.
# Pakai WAHA_SESSION tersendiri kalau instance WAHA-nya dipakai bareng aplikasi lain.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=wedplan

# Token untuk /api/cron/[job]. Kosong = endpoint cron menolak semua panggilan.
CRON_SECRET=

# AI konsultan. Provider apa pun yang bicara protokol OpenAI bisa dipakai.
# AI_API_KEY kosong = halaman AI menampilkan panduan, bukan error.
# DeepSeek langsung: AI_BASE_URL=https://api.deepseek.com
AI_BASE_URL=https://ai.sumopod.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
